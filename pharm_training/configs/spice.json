{
  "dataset": "spice",
  "manifest": "data/SPICE/prepared/manifest.json",
  "output_dir": "runs/pharm_training/spice",
  "spice_only": true,
  "epochs": 700,
  "batch_size": 8,
  "learning_rate": 0.0001,
  "weight_decay": 0.00001,
  "warmup_epochs": 0,
  "min_learning_rate": 0.000001,
  "energy_weight": 1.0,
  "force_weight": 0.0,
  "force_mode": "energy_only",
  "cutoff": 6.0,
  "gradient_clip": 10.0,
  "max_nonfinite_batches_per_epoch": 5,
  "scheduler": "plateau",
  "lr_reduce_factor": 0.5,
  "lr_patience": 6,
  "early_stopping_patience": 20,
  "minimum_epochs": 25,
  "min_delta": 0.001,
  "divergence_factor": 4.0,
  "selection_energy_scale_ev_per_atom": 0.043,
  "selection_force_scale_ev_per_angstrom": 0.1,
  "selection_energy_fraction": 1.0,
  "evaluate_test": true,
  "seed": 42,
  "subset_seed": 42,
  "num_workers": 4,
  "checkpoint_interval": 25,
  "train_limit": -1,
  "eval_limit": -1,
  "architecture": {
    "hidden_dim": 128,
    "depth": 6,
    "num_degrees": 2,
    "heads": 4,
    "num_neighbors": 1,
    "num_adj_degrees_embed": 2,
    "max_sparse_neighbors": 32,
    "valid_radius": 6.0,
    "attend_self": true,
    "l2_dist_attention": false
  }
}
